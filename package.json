{
  "name": "umg-presentaciones-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Centralizado de Proyección de Presentaciones Académicas (UMG - Campus Villa Nueva)",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "docker:prod:up": "docker compose up -d --build",
    "docker:prod:down": "docker compose down",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "keywords": [
    "umg",
    "presentaciones",
    "proyeccion",
    "express",
    "react",
    "sqlite",
    "winston"
  ],
  "author": "UMG Villa Nueva",
  "license": "ISC"
}
