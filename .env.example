# ========================================================
# Variables de Configuración - UMG Presentaciones
# ========================================================

# Entorno: 'development' o 'production'
NODE_ENV=development

# Puerto del servidor backend
PORT=8080

# Nivel de logging Winston: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=debug

# Rutas persistentes de almacenamiento
DB_PATH=./database.sqlite
UPLOADS_DIR=./uploads
LOGS_DIR=./logs

# Ruta de estáticos compilados de Vite (Frontend)
# En desarrollo: no requerida (Vite corre en 5173 con proxy)
# En producción: ruta a la carpeta dist
DIST_PATH=../frontend/dist
